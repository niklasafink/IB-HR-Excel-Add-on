# Cloudflare Pages – Cache-Steuerung für das Office-Add-in.
# HTML/Manifest nie cachen, damit Updates sofort im Office-WebView ankommen.
/*.html
  Cache-Control: no-cache
/manifest.xml
  Cache-Control: no-cache

# taskpane.css wird unter festem Namen verlinkt -> nicht dauerhaft cachen.
/*.css
  Cache-Control: no-cache

# JS trägt einen Content-Hash im Namen (siehe webpack output) -> dauerhaft cachen.
/*.js
  Cache-Control: public, max-age=31536000, immutable
