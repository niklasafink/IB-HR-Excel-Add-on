# OpenRegister API-Key — NUR serverseitig. Niemals ins Add-in-Bundle.
# Im OpenRegister-Dashboard erzeugen: https://openregister.de
OPENREGISTER_API_KEY=__hier_einsetzen__

# Port des Proxys
PORT=3001

# Erlaubter CORS-Origin (Origin des Add-in-Dev-Servers)
ALLOWED_ORIGIN=https://localhost:3000

# Basis-URL der OpenRegister-API (Default, normalerweise unverändert lassen)
OPENREGISTER_BASE_URL=https://api.openregister.de

# Cache-Lebensdauer pro company_id in Sekunden (spart Credits bei Wiederholläufen)
CACHE_TTL_SECONDS=86400