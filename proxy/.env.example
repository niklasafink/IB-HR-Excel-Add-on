# handelsregister.ai API-Key - NUR serverseitig. Niemals ins Add-in-Bundle.
# Im handelsregister.ai-Dashboard erzeugen: https://handelsregister.ai
HANDELSREGISTER_API_KEY=__hier_einsetzen__

# Port des Proxys
PORT=3001

# Erlaubter CORS-Origin (Origin des Add-in-Dev-Servers)
ALLOWED_ORIGIN=https://localhost:3000

# Basis-URL der handelsregister.ai-API (Default, normalerweise unverändert lassen)
HANDELSREGISTER_BASE_URL=https://handelsregister.ai/api

# Cache-Lebensdauer pro Anfrage in Sekunden (spart Credits bei Wiederholläufen)
CACHE_TTL_SECONDS=86400
